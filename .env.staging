# Staging build (npm run build:staging), read by native-bridge.js.
# Not secrets: these IDs ship inside the app binary.

# Google demo ad units, safe to tap (developers.google.com/admob/{android,ios}/test-ads).
VITE_ADMOB_REWARDED_ANDROID=ca-app-pub-3940256099942544/5224354917
VITE_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-3940256099942544/1033173712
VITE_ADMOB_REWARDED_IOS=ca-app-pub-3940256099942544/1712485313
VITE_ADMOB_INTERSTITIAL_IOS=ca-app-pub-3940256099942544/4411468910

# RevenueCat public SDK keys (Project settings > API keys). Empty skips RevenueCat.
VITE_RC_KEY_ANDROID=
VITE_RC_KEY_IOS=

VITE_ADS_TESTING=true
