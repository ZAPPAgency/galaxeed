# Release build (npm run build:release -- android|ios), read by native-bridge.js.
# Not secrets: these IDs ship inside the app binary.
# scripts/check-release.mjs refuses the build while a value of the target platform is empty.

# Real AdMob ad units (AdMob > Apps > Ad units).
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_INTERSTITIAL_ANDROID=
VITE_ADMOB_REWARDED_IOS=
VITE_ADMOB_INTERSTITIAL_IOS=

# RevenueCat public SDK keys (Project settings > API keys).
VITE_RC_KEY_ANDROID=
VITE_RC_KEY_IOS=

VITE_ADS_TESTING=false
